# Clang-format configuration for zsh C source code.
#
# This file was generated by analyzing the existing code style in Src/,
# the .editorconfig, and the Src/.indent.pro configuration.
#
# Usage:
#   clang-format -i Src/*.c Src/*.h
#
# Note: the zsh codebase uses a /**/  comment convention to mark exported
# symbols.  clang-format is not aware of this convention, so minor
# differences around those markers are expected.

Language: Cpp

# Use a base style close to the project's conventions, then override.
BasedOnStyle: LLVM

# -- Indentation --
# .editorconfig [*.[ch]]: indent_style = tab, indent_size = 4, tab_width = 8
# .indent.pro: --indent-level4, --tab-size8
IndentWidth: 4
TabWidth: 8
UseTab: Always
ContinuationIndentWidth: 4

# -- Column limit --
# .indent.pro: --line-length132
ColumnLimit: 132

# -- Brace breaking --
# Functions use Allman-style braces (opening brace on its own line).
# Control statements (if/else/for/while/switch) use attached braces.
# This matches the Linux kernel brace style.
# .indent.pro: --braces-on-if-line (attached braces for control flow)
# .indent.pro: --cuddle-else (} else { on same line)
BreakBeforeBraces: Linux

# -- Function return type --
# Return type (and qualifiers) appear on their own line for definitions:
#   static void
#   funcname(args)
#   {
# .indent.pro: --procnames-start-lines
AlwaysBreakAfterReturnType: TopLevelDefinitions

# -- Switch / Case --
# Case labels are at the same indentation level as the switch statement.
# .indent.pro: --case-indentation0
IndentCaseLabels: false

# -- Goto labels --
# Labels are typically at or near column zero.
IndentGotoLabels: false

# -- Pointer alignment --
# Pointers bind to the variable name: char *str, not char* str.
PointerAlignment: Right

# -- Spaces --
# .indent.pro: --no-space-after-function-call-names
SpaceBeforeParens: ControlStatements
# .indent.pro: --no-space-after-casts
SpaceAfterCStyleCast: false

# -- Preprocessor directives --
# Nested preprocessor directives use indentation after the hash:
#   #if FOO
#   # define BAR
#   #endif
IndentPPDirectives: AfterHash

# -- Short statements --
# The codebase does not place short if/while/for bodies on the same line.
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never
AllowShortFunctionsOnASingleLine: None
AllowShortCaseLabelsOnASingleLine: false

# -- Comments --
# .indent.pro: --dont-star-comments, --dont-format-comments
# Preserve the existing comment formatting.
ReflowComments: false

# -- Includes --
# Do not re-sort includes; the project has a specific include order.
SortIncludes: Never

# -- Alignment --
# The codebase occasionally aligns consecutive assignments (e.g. hash
# table setup in builtin.c) but this is not applied universally.
# Leaving these disabled avoids unexpected reformatting.
AlignConsecutiveAssignments: false
AlignConsecutiveDeclarations: false

# Keep trailing comments where they are.
AlignTrailingComments: true

# -- Other --
# Align escaped newlines in macros to the right.
AlignEscapedNewlines: Right

# Allow bin-packing of function arguments and parameters to match
# the existing style where arguments are packed onto lines.
BinPackArguments: true
BinPackParameters: true

# Keep empty lines as-is up to a maximum of 2.
MaxEmptyLinesToKeep: 2

# Do not indent inside extern "C" blocks (not commonly used, but safe).
IndentExternBlock: NoIndent

# -- Macros --
# mod_export is a macro that acts as a declaration attribute (expands
# to a visibility annotation or empty).  Treat it as an attribute so
# that clang-format does not misparse declarations.
AttributeMacros:
  - mod_export
